# App Environment
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=talentbench-super-secret-key-change-in-production-min-32-chars-long

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=talentbench

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# S3 / MinIO Object Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RESUMES=talentbench-resumes
S3_BUCKET_EXPORTS=talentbench-exports
S3_REGION=us-east-1
S3_USE_SSL=false

# LLM Gateway — Gemini, OmniRoute, or Groq ("gemini", "omniroute", "groq", "mock")
LLM_PROVIDER=gemini

# Google Gemini & Gemma Configuration
# Dynamic routing: <12k tokens -> gemma-4-31b-it, >=12k tokens -> gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=gemma-4-31b-it
GEMINI_FLASH_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_TOKEN_THRESHOLD=12000
GEMMA_RPM_LIMIT=30
GEMMA_TPM_LIMIT=16000
GEMINI_FLASH_LITE_RPM_LIMIT=15
GEMINI_FLASH_LITE_TPM_LIMIT=250000

# OmniRoute Configuration
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=sk-...
OMNIROUTE_MODEL_NAME=kamalai

# Groq Provider Configuration
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_RPM_LIMIT=30
GROQ_RPD_LIMIT=1000
GROQ_TPM_LIMIT=8000
GROQ_TPD_LIMIT=200000
GROQ_MAX_RETRIES=5

# Mail
MAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
FROM_EMAIL=noreply@talentbench.io
FROM_NAME="TalentBench Recruitment Team"


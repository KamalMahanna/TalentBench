# App Environment
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=talentbench-super-secret-key-change-in-production-min-32-chars-long

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=talentbench

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# S3 / MinIO Object Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RESUMES=talentbench-resumes
S3_BUCKET_EXPORTS=talentbench-exports
S3_REGION=us-east-1
S3_USE_SSL=false

# LLM Gateway — LangChain Groq (qwen/qwen3.8-27b)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_RPM_LIMIT=30
GROQ_RPD_LIMIT=1000
GROQ_TPM_LIMIT=8000
GROQ_TPD_LIMIT=200000
GROQ_MAX_RETRIES=5

# Mail
MAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
FROM_EMAIL=noreply@talentbench.io
FROM_NAME="TalentBench Recruitment Team"

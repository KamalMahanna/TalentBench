# ==============================================================================
# TalentBench Environment Variables
# ==============================================================================

# LLM Gateway Provider Selection: "gemini" (exclusive production engine)
LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# Google Gemini 3.5 Flash-Lite Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FLASH_LITE_RPM_LIMIT=15
GEMINI_FLASH_LITE_TPM_LIMIT=250000

# ------------------------------------------------------------------------------
# Optional Secondary / Fallback Providers
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_RPM_LIMIT=30
GROQ_TPM_LIMIT=8000

# ------------------------------------------------------------------------------
# Next.js / Application Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL="file:./dev.db"

# ==============================================================================
# TalentBench Environment Variables
# ==============================================================================

# LLM Gateway Provider Selection: "gemini", "omniroute", or "groq"
LLM_PROVIDER=gemini

# ------------------------------------------------------------------------------
# Google Gemini & Gemma Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
# Routing rule:
#   - Tokens < 12,000  => gemma-4-31b-it (Strict Quota: 30 RPM, 16K TPM)
#   - Tokens >= 12,000 => gemini-3.5-flash-lite (Strict Quota: 15 RPM, 250K TPM)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMMA_MODEL=gemma-4-31b-it
GEMINI_FLASH_LITE_MODEL=gemini-3.5-flash-lite
GEMINI_TOKEN_THRESHOLD=12000
GEMMA_RPM_LIMIT=30
GEMMA_TPM_LIMIT=16000
GEMINI_FLASH_LITE_RPM_LIMIT=15
GEMINI_FLASH_LITE_TPM_LIMIT=250000

# ------------------------------------------------------------------------------
# OmniRoute AI Gateway (OpenAI Compatible)
# ------------------------------------------------------------------------------
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=sk-omniroute-key
OMNIROUTE_MODEL_NAME=kamalai
OMNIROUTE_DOCKER_BASE_URL=http://172.17.0.1:20128/v1

# ------------------------------------------------------------------------------
# Groq Provider Configuration
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_RPM_LIMIT=30
GROQ_TPM_LIMIT=8000

# ------------------------------------------------------------------------------
# Next.js / Application Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL="file:./dev.db"

